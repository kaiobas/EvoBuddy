# ─── Supabase ─────────────────────────────────────────────────
# URL do projeto Supabase
SUPABASE_URL=https://xxxxx.supabase.co
# Chave service_role (NUNCA compartilhar com frontend)
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ─── Servidor ─────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────
# Dominios permitidos (separados por vírgula)
# Em produção: https://app.evobuddy.com,https://evobuddy.com
CORS_ORIGIN=http://localhost:5173

# ─── Cookie ───────────────────────────────────────────────────
# Domínio do cookie (produção: .evobuddy.com)
COOKIE_DOMAIN=localhost
# true em produção (HTTPS), false em dev (HTTP)
COOKIE_SECURE=false

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DEV_RAG_DB_URL")
}

model Session {
  id        String   @id @default(uuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[]
  snippets  ContextSnippet[]
}

model Message {
  id        String   @id @default(uuid())
  role      String
  content   String
  embedding String?
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model ContextSnippet {
  id        String   @id @default(uuid())
  filePath  String?
  content   String
  embedding String?
  tags      String   @default("[]")
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String?
  createdAt DateTime @default(now())

  @@index([sessionId])
}
